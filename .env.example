# Copy to `.env` (repo root) for Docker Compose, and to `apps/api/.env` for running the API
# directly. Never commit a real `.env`.

# --- Runtime -------------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
WEB_PORT=8080                       # host port for the web container

# --- PostgreSQL (Compose builds DATABASE_URL from these for the api container) --------------
POSTGRES_USER=mindguard
POSTGRES_PASSWORD=mindguard-dev-only
POSTGRES_DB=mindguard

# Used when running the API outside Docker against the Compose database.
DATABASE_URL=postgresql+asyncpg://mindguard:mindguard-dev-only@localhost:5432/mindguard

# --- Redis (rate limiting and session cache only) ----------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth --------------------------------------------------------------------------------
# Production refuses to start unless JWT_SECRET is a random 32+ character value
# (generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))")
# and COOKIE_SECURE=true (HTTPS only).
JWT_SECRET=dev-only-insecure-jwt-secret-do-not-use-in-production
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Per client IP. Campus networks put many students behind one address, so keep this generous.
AUTH_RATE_LIMIT_PER_MINUTE=30

# --- Safety engine ---------------------------------------------------------------------------
# embedding (default; multilingual sentence encoder baked into the Docker image),
# hashed (dependency-free fallback), or none (rules only). See docs/SAFETY.md.
SAFETY_CLASSIFIER=embedding
